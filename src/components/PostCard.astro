---
import { u } from '../data/site.js';
const { post } = Astro.props;
const { data, id } = post;
const dataFmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }).format(data.data);
---
<article class="post rv">
  <a class="post-link" href={u(`/blog/${id}`)}>
    <div class="thumb">
      {data.capa
        ? <img src={data.capa} alt="" width="800" height="450" loading="lazy" decoding="async" />
        : <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4zM8 9h8M8 13h8M8 17h5"/></svg>}
    </div>
    <div class="body">
      <p class="cat">{data.categoria}</p>
      <h3>{data.titulo}</h3>
      <p>{data.resumo}</p>
      <p class="meta"><time datetime={data.data.toISOString()}>{dataFmt}</time> · {data.leitura} min</p>
      <span class="read">Ler o artigo</span>
    </div>
  </a>
</article>
