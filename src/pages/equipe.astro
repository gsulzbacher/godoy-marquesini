---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { equipe } from '../data/equipe.js';
---
<Base
  title="Equipe | Godoy Marquesini Advocacia"
  description="Conheça os advogados do Godoy Marquesini Advocacia, escritório de Bauru/SP com atuação em Direito Trabalhista, Civil e Previdenciário."
>
  <PageHero kicker="Equipe" titulo="Conheça os profissionais por trás de cada estratégia"
    lead="Uma equipe que alia conhecimento técnico, experiência e atuação estratégica, trabalhando de forma integrada e comprometida com as particularidades de cada caso." />

  <section>
    <div class="wrap">
      <div class="team">
        {equipe.map((p) => (
          <article class="member rv">
            <div class="av">
              <img src={p.foto} alt={p.nome} width="900" height="1134" loading="lazy" decoding="async" style={`object-position:${p.pos}`} />
            </div>
            <div class="body">
              <h2>{p.curto}</h2>
              <p class="role">{p.papel} · {p.oab}</p>
              <p>{p.bio}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="prosa rv" style="max-width:62ch;margin:54px auto 0;text-align:center">
        Cada caso é acompanhado de forma individualizada, por uma equipe que conhece sua história, compreende suas necessidades e atua de maneira integrada, garantindo continuidade, proximidade e transparência em todas as etapas do processo.
      </p>
    </div>
  </section>

  <CtaFinal titulo="Estamos prontos para ouvir você." texto="Conte-nos sua situação. Nossa equipe avaliará suas necessidades e orientará sobre os próximos passos para o atendimento jurídico." />
</Base>
