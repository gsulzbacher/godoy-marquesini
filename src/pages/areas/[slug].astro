---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { areas } from '../../data/areas.js';
import { u } from '../../data/site.js';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
const outras = areas.filter((a) => a.slug !== area.slug);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: area.nome,
  provider: { '@type': 'LegalService', name: 'Godoy Marquesini Advocacia' },
  areaServed: 'BR',
  description: area.intro,
};
---
<Base title={area.seo.title} description={area.seo.description} schema={schema}>
  <PageHero kicker="Área de atuação" titulo={area.nome} lead={area.intro} />

  <section>
    <div class="wrap">
      <h2 class="rv" style="margin-bottom:36px">Situações que atendemos</h2>
      <div class="situacoes">
        {area.itens.map(([t, d]) => (
          <div class="situacao rv"><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2 class="rv" style="margin-bottom:28px">Outras áreas</h2>
      <div class="pillars pillars-2">
        {outras.map((a) => (
          <article class="pillar rv">
            <h3>{a.nome}</h3>
            <p>{a.curto}</p>
            <a class="more" href={u(`/areas/${a.slug}`)}>Ver a área</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal titulo={area.fecho} texto="A primeira conversa serve para entender a sua situação e explicar os caminhos possíveis." />
</Base>
