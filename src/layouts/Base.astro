---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
// importados para o Vite versionar e reescrever a URL conforme o base do ambiente
import heroBg from '../assets/hero-bg.jpg';
import fonteSerif from '../assets/fonts/dm-serif-display-latin-400-normal.woff2?url';
import fonteSans400 from '../assets/fonts/montserrat-latin-400-normal.woff2?url';
import fonteSans700 from '../assets/fonts/montserrat-latin-700-normal.woff2?url';

const {
  title,
  description,
  preloadHero = false,
  schema = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// a prévia no github.io não pode ser indexada: competiria com o domínio real
const naoIndexar = import.meta.env.NAO_INDEXAR === 'true' || process.env.NAO_INDEXAR === 'true';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#07012b" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={site.nome} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  {preloadHero && <link rel="preload" as="image" href={heroBg.src} fetchpriority="high" />}
  <link rel="preload" as="font" type="font/woff2" href={fonteSerif} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={fonteSans400} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={fonteSans700} crossorigin />
  {naoIndexar && <meta name="robots" content="noindex,nofollow" />}
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="skip" href="#main">Pular para o conteúdo</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <script>
    const hd = document.getElementById('hd');
    addEventListener('scroll', () => hd.classList.toggle('solid', scrollY > 40), { passive: true });

    const menosMovimento = matchMedia('(prefers-reduced-motion: reduce)');
    const alvos = document.querySelectorAll('.rv');
    if (!menosMovimento.matches) {
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      alvos.forEach((el, i) => { el.style.transitionDelay = (i % 3) * 70 + 'ms'; io.observe(el); });
    } else {
      alvos.forEach((el) => el.classList.add('in'));
    }

    // menu mobile
    const burger = document.querySelector('.burger');
    const drawer = document.getElementById('drawer');
    let focoAnterior = null;
    function abrirMenu(abrir) {
      drawer.dataset.open = abrir ? 'true' : 'false';
      burger.setAttribute('aria-expanded', abrir ? 'true' : 'false');
      burger.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
      document.body.style.overflow = abrir ? 'hidden' : '';
      if (abrir) { focoAnterior = document.activeElement; drawer.querySelector('.close').focus(); }
      else if (focoAnterior) { focoAnterior.focus(); focoAnterior = null; }
    }
    burger.addEventListener('click', () => abrirMenu(drawer.dataset.open !== 'true'));
    drawer.addEventListener('click', (e) => {
      if (e.target.closest('[data-close]') || e.target.closest('a')) abrirMenu(false);
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.dataset.open === 'true') abrirMenu(false); });
    drawer.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const f = [...drawer.querySelectorAll('button,a[href]')];
      const primeiro = f[0], ultimo = f[f.length - 1];
      if (e.shiftKey && document.activeElement === primeiro) { e.preventDefault(); ultimo.focus(); }
      else if (!e.shiftKey && document.activeElement === ultimo) { e.preventDefault(); primeiro.focus(); }
    });

    // FAQ
    document.querySelectorAll('.q button').forEach((b) =>
      b.addEventListener('click', () => {
        const q = b.closest('.q');
        const painel = document.getElementById(b.getAttribute('aria-controls'));
        const abrindo = !q.classList.contains('open');
        document.querySelectorAll('.q').forEach((o) => {
          o.classList.remove('open');
          o.querySelector('button').setAttribute('aria-expanded', 'false');
          const op = o.querySelector('.a');
          op.style.maxHeight = null;
          op.hidden = true;
        });
        if (abrindo) {
          q.classList.add('open');
          b.setAttribute('aria-expanded', 'true');
          painel.hidden = false;
          painel.style.maxHeight = painel.scrollHeight + 'px';
        }
      })
    );
  </script>
</body>
</html>
